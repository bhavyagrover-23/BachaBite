        quote: 'Dinner plans, sorted.'
      }
    ];

    // State
    let foods = JSON.parse(localStorage.getItem('bachat_foods')) || initialFoods;
    let reservations = JSON.parse(localStorage.getItem('bachat_reservations')) || [];
    let followedDukaans = JSON.parse(localStorage.getItem('bachat_followed')) || [];
    let bachatPoints = Number(localStorage.getItem('bachat_points')) || 120;
    let currentPref = 'all';
    let selectedFoodForModal = null;
    let isByocActive = false;

    // Save to LocalStorage
    function syncStorage() {
      localStorage.setItem('bachat_foods', JSON.stringify(foods));
      localStorage.setItem('bachat_reservations', JSON.stringify(reservations));
      localStorage.setItem('bachat_followed', JSON.stringify(followedDukaans));
      localStorage.setItem('bachat_points', bachatPoints.toString());
      updateCounters();
    }

    // Update Header counters
    function updateCounters() {
      document.getElementById('headerCoinCount').textContent = bachatPoints;
      document.getElementById('modalBigCoinCount').textContent = bachatPoints;
      document.getElementById('orderCountBadge').textContent = reservations.length;
    }

    // Render Cards in Marketplace
    function filterAndRenderCards() {
      const search = (document.getElementById('searchInput').value || '').toLowerCase();
      const priceFilter = document.getElementById('priceSelect').value;
      const sortVal = document.getElementById('sortSelect').value;

      let list = foods.filter(item => {
        // Search match
        const matchSearch = (`${item.name} ${item.partner} ${item.type}`).toLowerCase().includes(search);
        
        // Price match
        const matchPrice = priceFilter === 'all' || item.price <= Number(priceFilter);

        // Preference match
        let matchPref = true;
        if (currentPref === 'under99') matchPref = item.price <= 99;
        else if (currentPref === 'veg') matchPref = item.type === 'veg' || item.pref === 'veg';
        else if (currentPref === 'nonveg') matchPref = item.type === 'nonveg' || item.pref === 'nonveg';
        else if (currentPref === 'bakery') matchPref = item.type === 'bakery' || item.pref === 'bakery';
        else if (currentPref === 'jain') matchPref = !!item.jain;
        else if (currentPref === 'spicy') matchPref = !!item.spicy;

        return matchSearch && matchPrice && matchPref;
      });

      // Sorting
      list.sort((a, b) => {
        if (sortVal === 'saving') {
          return (b.original - b.price) - (a.original - a.price);
        } else if (sortVal === 'low') {
          return a.price - b.price;
        } else if (sortVal === 'time') {
          return a.mins - b.mins;
        } else {
          return parseFloat(a.distance) - parseFloat(b.distance);
        }
      });

      const container = document.getElementById('foodCardsGrid');
      if (!list.length) {
        container.innerHTML = `
          <div style="grid-column:1/-1;background:#FFF;border:2px dashed var(--border);border-radius:20px;padding:48px 20px;text-align:center">
            <div style="font-size:3rem;margin-bottom:10px">🍲</div>
            <h3 style="margin:0 0 6px">No surplus meals match these filters</h3>
            <p style="color:var(--muted);font-size:0.9rem;margin:0 0 16px">Try clearing filters or check back at 7 PM for the new drop!</p>
            <button class="btn-3d" onclick="resetFilters()">Reset All Filters</button>
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(f => {
        const savings = f.original - f.price;
        const discountPercent = Math.round((savings / f.original) * 100);
        const isFav = followedDukaans.includes(f.partner);
        const isSoldOut = f.qty <= 0;

        return `
          <article class="food-card" id="card-${f.id}">
            <div class="card-media">
              <img src="${f.img}" alt="${f.name}" loading="lazy" />
              <div class="badge-bhookh">
                <span>${f.type === 'nonveg' ? '🔴 Non-Veg' : f.type === 'bakery' ? '🥐 Bakery' : '🟢 Pure Veg'}</span>
              </div>
              <div class="badge-discount-3d">
                ${discountPercent}% OFF
              </div>
              <button class="fav-heart-btn ${isFav ? 'active' : ''}" onclick="toggleFav('${f.partner}', this)" title="Follow ${f.partner}">
                ${isFav ? '❤️' : '🤍'}
              </button>
            </div>

            <div class="card-content">
              <div class="dukaan-row">
                <span class="dukaan-name">🏪 ${f.partner}</span>
                <span class="rating-badge">${f.dukaanRating || '4.8 ★'}</span>
              </div>

              <h3 class="item-title">${f.name}</h3>

              <div class="item-quote">“${f.quote || 'Paisa vasool, food rescue.'}”</div>

              <div class="price-savings-box">
                <div>
                  <span class="price-current">₹${f.price}</span>
                  <span class="price-original">₹${f.original}</span>
                </div>
                <div class="savings-badge">
                  Aapne ₹${savings} bachaye!
                </div>
              </div>

              <div class="card-meta">
                <span>📦 ${isSoldOut ? '<span style="color:#B91C1C;font-weight:800">SOLD OUT</span>' : f.qty + ' left · ' + f.distance}</span>
                <span class="pickup-timer">⏰ By ${f.time}</span>
              </div>

              <div class="card-actions">
                ${isSoldOut ? 
                  `<button class="btn-3d secondary" disabled style="opacity:0.6;cursor:not-allowed">Sold Out Today</button>` :
                  `<button class="btn-3d" onclick="openReservationModal(${f.id})">Reserve Meal</button>`
                }
                <a href="https://api.whatsapp.com/send?text=${encodeURIComponent(`Bhai dekh! ${f.name} is ₹${f.price} (was ₹${f.original}) at ${f.partner} on BachaBite. Check it out before it sells out!`)}" target="_blank" class="whatsapp-btn" title="Share with college friends on WhatsApp">
                  💬
                </a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    // Set Preference Filter
    function setPreference(pref, btnEl) {
      currentPref = pref;
      document.querySelectorAll('.preference-scroll .chip').forEach(c => c.classList.remove('active'));
      btnEl.classList.add('active');
      filterAndRenderCards();
    }

    function filterUnder99() {
      switchPage('home');
      const under99Chip = document.querySelector('[data-pref="under99"]');
      if (under99Chip) setPreference('under99', under99Chip);
      document.getElementById('dealsFilterSection').scrollIntoView({ behavior: 'smooth' });
    }

    function scrollToDeals() {
      switchPage('home');
      document.getElementById('aajKaDealHead').scrollIntoView({ behavior: 'smooth' });
    }

    function scrollToRescue() {
      switchPage('home');
      document.getElementById('rescueBoxSection').scrollIntoView({ behavior: 'smooth' });
    }

    function resetFilters() {
      document.getElementById('searchInput').value = '';
      document.getElementById('priceSelect').value = 'all';
      document.getElementById('sortSelect').value = 'near';
      const allChip = document.querySelector('[data-pref="all"]');
      if (allChip) setPreference('all', allChip);
    }

    // Reservation Modal Flow
    function openReservationModal(foodId) {
      selectedFoodForModal = foods.find(f => f.id === foodId);
      if (!selectedFoodForModal || selectedFoodForModal.qty <= 0) {
        showToast('Sorry, this deal is already sold out!');
        return;
      }

      isByocActive = false;
      document.getElementById('byocCheckbox').checked = false;
      document.getElementById('modalByocDiscountRow').classList.add('hide');

      document.getElementById('modalItemTitle').textContent = `Reserve ${selectedFoodForModal.name}`;
      document.getElementById('modalDukaanInfo').textContent = `Collect directly from ${selectedFoodForModal.partner} before ${selectedFoodForModal.time}.`;
      document.getElementById('modalSummaryItemName').textContent = selectedFoodForModal.name;
      document.getElementById('modalSummaryItemPrice').textContent = `₹${selectedFoodForModal.price}`;
      
      calculateCheckoutTotal();
      openModal('reservationModal');
    }

    function reserveCustomBox(boxName, partnerName, price, original, emoji) {
      selectedFoodForModal = {
        id: Date.now(),
        name: boxName,
        partner: partnerName,
        price: price,
        original: original,
        time: '9:30 PM',
        mins: 60,
        qty: 1
      };
      isByocActive = false;
      document.getElementById('byocCheckbox').checked = false;
      document.getElementById('modalByocDiscountRow').classList.add('hide');

      document.getElementById('modalItemTitle').textContent = `Reserve ${boxName}`;
      document.getElementById('modalDukaanInfo').textContent = `Packed fresh today by ${partnerName}. Collect before 9:30 PM.`;
      document.getElementById('modalSummaryItemName').textContent = boxName;
      document.getElementById('modalSummaryItemPrice').textContent = `₹${price}`;

      calculateCheckoutTotal();
      openModal('reservationModal');
    }

    function toggleByocOption() {
      isByocActive = document.getElementById('byocCheckbox').checked;
      const discountRow = document.getElementById('modalByocDiscountRow');
      if (isByocActive) {
        discountRow.classList.remove('hide');
        showToast('🥣 BYOC Selected! ₹5 platform fee waived + 25 Bachat Coins rewarded!');
      } else {
        discountRow.classList.add('hide');
      }
      calculateCheckoutTotal();
    }

    function calculateCheckoutTotal() {
      const basePrice = selectedFoodForModal ? selectedFoodForModal.price : 0;
      const fee = isByocActive ? 0 : 5;
      const total = basePrice + fee;
      document.getElementById('modalFeeText').textContent = isByocActive ? '₹0 (BYOC waived)' : '₹5';
      document.getElementById('modalSummaryTotal').textContent = `₹${total}`;
    }

    function confirmReservationFinal() {
      if (!selectedFoodForModal) return;

      // Decrement stock if in catalog
      const catalogItem = foods.find(f => f.id === selectedFoodForModal.id);
      if (catalogItem && catalogItem.qty > 0) {
        catalogItem.qty -= 1;
      }

      // Generate 6 digit secret pickup code
      const pickupOtp = Math.floor(100000 + Math.random() * 900000).toString().replace(/(\d{3})(\d{3})/, '$1 $2');
      
      // Calculate reward coins
      const coinsEarned = isByocActive ? 35 : 10;
      bachatPoints += coinsEarned;

      // Record reservation
      const newOrder = {
        orderId: 'BB-' + Math.floor(10000 + Math.random() * 90000),
        code: pickupOtp,
        itemName: selectedFoodForModal.name,
        partner: selectedFoodForModal.partner,
        price: selectedFoodForModal.price,
        time: selectedFoodForModal.time,
        byoc: isByocActive,
        isGroup: document.getElementById('groupPickupCheckbox').checked,
        createdAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      };
      reservations.unshift(newOrder);
      syncStorage();
      filterAndRenderCards();
      renderPartnerListings();

      closeModal('reservationModal');

      // Populate confirmation modal
      document.getElementById('confirmedCodeDisplay').textContent = pickupOtp;
      document.getElementById('confirmedItemSummary').textContent = `${newOrder.itemName} at ${newOrder.partner}`;
      document.getElementById('confirmedTimeSummary').textContent = `Pickup before ${newOrder.time}`;
      document.getElementById('earnedCoinsText').textContent = `+${coinsEarned} Bachat Coins`;

      openModal('confirmedModal');
      showToast('🎉 Meal reserved successfully! Show your code at the counter.');
    }

    function sharePickupOnWhatsApp() {
      if (!reservations.length) return;
      const o = reservations[0];
      const text = `Hey! I reserved ${o.itemName} at ${o.partner} on BachaBite. Pickup OTP: *${o.code}* before ${o.time}.`;
      window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
    }

    // My Orders Drawer
    function openOrdersModal() {
      const container = document.getElementById('ordersListContainer');
      if (!reservations.length) {
        container.innerHTML = `
          <div style="text-align:center;padding:32px 10px;background:#FDFBF8;border-radius:18px;border:1px dashed var(--border)">
            <div style="font-size:2.8rem;margin-bottom:8px">🛍️</div>
            <strong style="display:block;margin-bottom:4px">No active pickups right now</strong>
            <p style="color:var(--muted);font-size:0.84rem;margin:0 0 14px">Reserve delicious surplus meals before they go to waste.</p>
            <button class="btn-3d" onclick="closeModal('ordersModal');switchPage('home')">Browse Deals</button>
          </div>
        `;
      } else {
        container.innerHTML = reservations.map((o, idx) => `
          <div style="background:#FFF;border:1.5px solid #FCD34D;border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:0 4px 12px rgba(245,158,11,0.1)">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
              <span class="savings-badge">● Ready for Pickup</span>
              <span style="font-size:0.75rem;color:var(--muted)">Order #${o.orderId}</span>
            </div>
            <h4 style="margin:0 0 4px;font-size:1.1rem">${o.itemName}</h4>
            <div style="font-size:0.82rem;color:var(--ink-soft);margin-bottom:10px">🏪 ${o.partner} · Collect by <strong>${o.time}</strong></div>
            
            <div style="background:#FEF3C7;border-radius:10px;padding:10px;display:flex;justify-content:space-between;align-items:center">
              <div>
                <span style="font-size:0.7rem;text-transform:uppercase;color:#92400E;font-weight:800">PICKUP OTP CODE</span>
                <div style="font-size:1.3rem;font-weight:900;letter-spacing:2px;color:#78350F">${o.code}</div>
              </div>
              <button class="btn-3d green" style="padding:6px 12px;font-size:0.78rem" onclick="markOrderCollected(${idx})">
                Collected ✓
              </button>
            </div>
          </div>
        `).join('');
      }
      openModal('ordersModal');
    }

    function markOrderCollected(idx) {
      reservations.splice(idx, 1);
      syncStorage();
      openOrdersModal();
      showToast('Pickup verified! Shukriya for rescuing food! 🍲');
    }

    function openPointsModal() {
      openModal('pointsModal');
    }

    // Modal helpers
    function openModal(id) {
      document.getElementById(id).classList.add('open');
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }
    document.querySelectorAll('.modal-backdrop').forEach(m => {
      m.addEventListener('click', e => {
        if (e.target === m) m.classList.remove('open');
      });
    });

    // Page Switching (Home / Partner / Impact)
    function switchPage(pageKey) {
      document.querySelectorAll('.page-section').forEach(p => p.classList.add('hide'));
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.mob-btn').forEach(b => b.classList.remove('active'));

      if (pageKey === 'home') {
        document.getElementById('homePage').classList.remove('hide');
        document.querySelector('.nav-btn[data-page="home"]')?.classList.add('active');
      } else if (pageKey === 'partner') {
        document.getElementById('partnerPage').classList.remove('hide');
        document.querySelector('.nav-btn[data-page="partner"]')?.classList.add('active');
        renderPartnerListings();
      } else if (pageKey === 'impact') {
        document.getElementById('impactPage').classList.remove('hide');
        document.querySelector('.nav-btn[data-page="impact"]')?.classList.add('active');
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Partner Listing Submission
    function handlePartnerSubmit(e) {
      e.preventDefault();
      const pName = document.getElementById('pName').value;
      const pType = document.getElementById('pType').value;
      const pQty = Number(document.getElementById('pQty').value);
      const pTimeRaw = document.getElementById('pTime').value;
      const pOrig = Number(document.getElementById('pOrig').value);
      const pPrice = Number(document.getElementById('pPrice').value);
      const imgChoice = document.getElementById('pImageChoice').value;

      const imgMap = {
        samosa: 'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=800&q=80',
        biryani: 'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80',
        dosa: 'https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=800&q=80',
        roll: 'https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=800&q=80',
        bakery: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=800&q=80',
        thali: 'https://images.unsplash.com/photo-1610192244261-3f33de3f55e4?auto=format&fit=crop&w=800&q=80',
        pizza: 'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=800&q=80'
      };

      const newItem = {
        id: Date.now(),
        name: pName,
        partner: 'Your Dukaan (Civil Lines)',
        dukaanRating: '5.0 ★',
        type: pType,
        pref: pType,
        spicy: pType === 'spicy',
        jain: pType === 'jain',
        img: imgMap[imgChoice] || imgMap.thali,
        original: pOrig,
        price: pPrice,
        qty: pQty,
        time: formatTimeToAmPm(pTimeRaw),
        mins: 60,
        distance: '0.1 km',
        quote: 'Freshly packed. Financially friendly.'
      };

      foods.unshift(newItem);
      syncStorage();
      renderPartnerListings();
      filterAndRenderCards();
      e.target.reset();
      showToast('🎉 Your surplus food listing is now LIVE across BachaBite!');
    }

    function formatTimeToAmPm(timeStr) {
      if (!timeStr) return '9:30 PM';
      const [h, m] = timeStr.split(':');
      const hour = Number(h);
      const suffix = hour >= 12 ? 'PM' : 'AM';
      const formattedH = ((hour + 11) % 12 + 1);
      return `${formattedH}:${m} ${suffix}`;
    }

    function renderPartnerListings() {
      const container = document.getElementById('partnerListingsList');
      const partnerItems = foods.filter(f => f.partner.includes('Your Dukaan') || f.id > 100);
      document.getElementById('partnerLiveCount').textContent = `${partnerItems.length} Live`;

      if (!partnerItems.length) {
        container.innerHTML = `
          <div style="color:var(--muted);font-size:0.85rem;padding:14px;background:#FDFBF8;border-radius:10px;text-align:center">
            No live listings yet. Fill out the quick form on the left to publish surplus!
          </div>
        `;
        return;
      }

      container.innerHTML = partnerItems.map(f => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--border)">
          <div>
            <strong style="font-size:0.95rem;display:block">${f.name}</strong>
            <span style="font-size:0.78rem;color:var(--muted)">${f.qty} remaining · ₹${f.price} · Pickup by ${f.time}</span>
          </div>
          <button class="btn-3d secondary" style="padding:5px 10px;font-size:0.75rem" onclick="deletePartnerItem(${f.id})">
            Remove
          </button>
        </div>
      `).join('');
    }

    function deletePartnerItem(id) {
      foods = foods.filter(f => f.id !== id);
      syncStorage();
      renderPartnerListings();
      filterAndRenderCards();
      showToast('Listing removed.');
    }

    // Follow / Favourite Dukaan
    function toggleFav(partnerName, btnEl) {
      if (followedDukaans.includes(partnerName)) {
        followedDukaans = followedDukaans.filter(p => p !== partnerName);
        btnEl.classList.remove('active');
        btnEl.innerHTML = '🤍';
        showToast(`Unfollowed ${partnerName}`);
      } else {
        followedDukaans.push(partnerName);
        btnEl.classList.add('active');
        btnEl.innerHTML = '❤️';
        showToast(`❤️ Following ${partnerName}! Deal alerts enabled for their 7 PM drops.`);
      }
      syncStorage();
    }

    function toggleFollowDukaan(dukaanName, btnEl) {
      if (followedDukaans.includes(dukaanName)) {
        followedDukaans = followedDukaans.filter(p => p !== dukaanName);
        btnEl.textContent = '❤️ Follow';
        showToast(`Unfollowed ${dukaanName}`);
      } else {
        followedDukaans.push(dukaanName);
        btnEl.textContent = '✓ Following';
        showToast(`🔔 Alert set! You'll be notified when ${dukaanName} drops evening surplus.`);
      }
      syncStorage();
    }

    function toggleDropAlert() {
      showToast('🔔 Notification scheduled for 7:00 PM Daily Saver Drops!');
    }

    // Countdown Timer simulation
    setInterval(() => {
      const now = new Date();
      const target = new Date();
      target.setHours(19, 0, 0, 0); // 7:00 PM
      if (now > target) target.setDate(target.getDate() + 1);

      const diff = Math.floor((target - now) / 1000);
      const h = String(Math.floor(diff / 3600)).padStart(2, '0');
      const m = String(Math.floor((diff % 3600) / 60)).padStart(2, '0');
      const s = String(diff % 60).padStart(2, '0');

      const elH = document.getElementById('dropHrs');
      const elM = document.getElementById('dropMins');
      const elS = document.getElementById('dropSecs');
      if (elH) elH.textContent = h;
      if (elM) elM.textContent = m;
      if (elS) elS.textContent = s;
    }, 1000);

    // Toast Function
    let toastTimeout = null;
    function showToast(msg) {
      const t = document.getElementById('toastBox');
      document.getElementById('toastText').textContent = msg;
      t.classList.add('show');
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        t.classList.remove('show');
      }, 3200);
    }

    // Initial render
    filterAndRenderCards();
    updateCounters();
  </script>
</body>
</html>
